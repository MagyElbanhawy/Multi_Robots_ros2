<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="emrmf_indoor">
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <gravity>0 0 -9.8</gravity>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 14 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 14 0.1</size></box></geometry>
          <material><ambient>0.78 0.78 0.78 1</ambient><diffuse>0.78 0.78 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 7 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.12 2</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -7 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.12 2</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>9 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 14 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 14 2</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-9 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 14 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 14 2</size></box></geometry></visual></link></model>
    <model name="room_divider_a"><static>true</static><pose>-2.8 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 7 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 7 2</size></box></geometry></visual></link></model>
    <model name="room_divider_b"><static>true</static><pose>3.0 1.5 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 6 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 6 2</size></box></geometry></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>-5 -3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>5 4 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></visual></link></model>
  </world>
</sdf>
