<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="emrmf_indoor">
    <!-- Gazebo Classic + ROS 2 Humble integration plugins. -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.72 0.76 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Lighting: one sun source plus two office/warehouse ceiling lights. -->
    <include>
      <uri>model://sun</uri>
    </include>
    <light name="ceiling_light_west" type="point">
      <pose>-3.75 0 3.0 0 0 0</pose>
      <diffuse>0.85 0.85 0.78 1</diffuse>
      <specular>0.15 0.15 0.12 1</specular>
      <attenuation><range>9</range><constant>0.6</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="ceiling_light_east" type="point">
      <pose>3.75 0 3.0 0 0 0</pose>
      <diffuse>0.85 0.85 0.78 1</diffuse>
      <specular>0.15 0.15 0.12 1</specular>
      <attenuation><range>9</range><constant>0.6</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- Approximate 15 m x 10 m ground plane. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>15 10 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>15 10 0.05</size></box></geometry>
          <material><ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer walls for the 15 m x 10 m indoor office/warehouse footprint. -->
    <model name="wall_north"><static>true</static><pose>0 5 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>15 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>15 0.12 2</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -5 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>15 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>15 0.12 2</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>7.5 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 10 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 10 2</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-7.5 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 10 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 10 2</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual></link></model>

    <!-- Interior layout: multiple rooms connected through central corridors and door gaps. -->
    <model name="center_corridor_west_wall"><static>true</static><pose>-2.7 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 6.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 6.2 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="center_corridor_east_wall"><static>true</static><pose>2.7 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 6.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 6.2 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="north_room_split_left"><static>true</static><pose>-5.1 1.3 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 2.9 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.9 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="south_room_split_left"><static>true</static><pose>-5.1 -1.4 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 2.7 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.7 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="warehouse_partition_east_north"><static>true</static><pose>5.1 2.1 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 3.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 3.2 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="warehouse_partition_east_south"><static>true</static><pose>5.1 -2.0 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 3.0 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 3.0 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>
    <model name="short_corridor_barrier"><static>true</static><pose>0 2.65 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 3.0 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 3.0 2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual></link></model>

    <!-- Static SLAM landmarks and obstacles: warehouse racks, desks, crates, and pillars. -->
    <model name="rack_west"><static>true</static><pose>-5.8 3.4 0.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.6 0.55 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.6 0.55 1.1</size></box></geometry><material><ambient>0.45 0.42 0.35 1</ambient><diffuse>0.45 0.42 0.35 1</diffuse></material></visual></link></model>
    <model name="rack_east"><static>true</static><pose>5.8 3.3 0.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.7 0.55 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.7 0.55 1.1</size></box></geometry><material><ambient>0.45 0.42 0.35 1</ambient><diffuse>0.45 0.42 0.35 1</diffuse></material></visual></link></model>
    <model name="desk_room_a"><static>true</static><pose>-5.3 -3.2 0.38 0 0 0.2</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 0.7 0.75</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.7 0.75</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual></link></model>
    <model name="desk_room_b"><static>true</static><pose>-1.0 -3.4 0.38 0 0 -0.15</pose><link name="link"><collision name="collision"><geometry><box><size>1.1 0.7 0.75</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.7 0.75</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material></visual></link></model>
    <model name="crate_stack_1"><static>true</static><pose>4.4 -3.4 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.9</size></box></geometry><material><ambient>0.60 0.42 0.18 1</ambient><diffuse>0.60 0.42 0.18 1</diffuse></material></visual></link></model>
    <model name="crate_stack_2"><static>true</static><pose>6.2 -1.1 0.35 0 0 0.4</pose><link name="link"><collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.60 0.42 0.18 1</ambient><diffuse>0.60 0.42 0.18 1</diffuse></material></visual></link></model>
    <model name="pillar_center"><static>true</static><pose>0.0 -0.2 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.28</radius><length>1.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>1.6</length></cylinder></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link></model>
    <model name="pillar_south"><static>true</static><pose>1.5 -3.2 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.6</length></cylinder></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link></model>

    <!-- Robot spawn locations, kept collision-free for 2, 3, 4, and 5 robot experiments. -->
    <model name="robot_spawn_1"><static>true</static><pose>-6.2 -4.0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="robot_spawn_2"><static>true</static><pose>-6.2 4.0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="robot_spawn_3"><static>true</static><pose>6.2 -4.0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="robot_spawn_4"><static>true</static><pose>6.2 4.0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="robot_spawn_5"><static>true</static><pose>0.0 -4.1 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual></link></model>
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <gravity>0 0 -9.8</gravity>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 14 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 14 0.1</size></box></geometry>
          <material><ambient>0.78 0.78 0.78 1</ambient><diffuse>0.78 0.78 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 7 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.12 2</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -7 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.12 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.12 2</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>9 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 14 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 14 2</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-9 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 14 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 14 2</size></box></geometry></visual></link></model>
    <model name="room_divider_a"><static>true</static><pose>-2.8 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 7 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 7 2</size></box></geometry></visual></link></model>
    <model name="room_divider_b"><static>true</static><pose>3.0 1.5 1 0 0 1.5708</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 6 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 6 2</size></box></geometry></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>-5 -3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>5 4 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></visual></link></model>
  </world>
</sdf>
