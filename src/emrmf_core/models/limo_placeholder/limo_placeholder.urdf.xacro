<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="limo_placeholder">
  <xacro:arg name="robot_name" default="limo_1"/>
  <xacro:arg name="robot_namespace" default="/limo_1"/>
  <xacro:arg name="sensor_noise_std" default="0.02"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="14.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.20" iyy="0.23" izz="0.30" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision name="base_collision">
      <geometry><box size="0.62 0.42 0.18"/></geometry>
    </collision>
    <visual name="base_visual">
      <geometry><box size="0.62 0.42 0.18"/></geometry>
      <material name="limo_blue"><color rgba="0.05 0.18 0.55 1"/></material>
    </visual>
  </link>

  <link name="top_cover">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.45 0.30 0.04"/></geometry>
      <material name="black"><color rgba="0.02 0.02 0.025 1"/></material>
    </visual>
  </link>
  <joint name="top_cover_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_cover"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.055"/></geometry>
      <material name="laser_black"><color rgba="0.01 0.01 0.01 1"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.17 0 0.17" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel">
    <inertial><mass value="0.6"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.105" length="0.045"/></geometry></collision>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.105" length="0.045"/></geometry><material name="wheel"><color rgba="0.02 0.02 0.02 1"/></material></visual>
  </link>
  <link name="front_right_wheel">
    <inertial><mass value="0.6"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.105" length="0.045"/></geometry></collision>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.105" length="0.045"/></geometry><material name="wheel"/></visual>
  </link>
  <link name="rear_left_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.075" length="0.035"/></geometry><material name="wheel"/></visual>
  </link>
  <link name="rear_right_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.075" length="0.035"/></geometry><material name="wheel"/></visual>
  </link>

  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.22 0.235 -0.035" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.22 -0.235 -0.035" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="fixed"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.22 0.235 -0.045" rpy="0 0 0"/></joint>
  <joint name="rear_right_wheel_joint" type="fixed"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.22 -0.235 -0.045" rpy="0 0 0"/></joint>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="top_cover"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_right_wheel"><material>Gazebo/Black</material></gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
        <remapping>/tf:=tf</remapping>
      </ros>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.47</wheel_separation>
      <wheel_diameter>0.21</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <update_rate>50</update_rate>
      <covariance_x>$(arg sensor_noise_std)</covariance_x>
      <covariance_y>$(arg sensor_noise_std)</covariance_y>
      <covariance_yaw>$(arg sensor_noise_std)</covariance_yaw>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="limo_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.08</min><max>12.0</max><resolution>0.02</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>$(arg sensor_noise_std)</stddev></noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>$(arg robot_namespace)</namespace><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
